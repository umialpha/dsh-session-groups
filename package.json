{
  "name": "dsh-session-groups-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -b tsconfig.host.json && tsdown --config-loader native --env.DSH_BUILD_FACE host",
    "build:client": "tsc -b tsconfig.client.json && tsdown --config-loader native --env.DSH_BUILD_FACE client",
    "typecheck": "pnpm run build:host && tsc -b tsconfig.client.json",
    "test": "vitest run",
    "lint": "oxlint .",
    "check": "pnpm run typecheck && pnpm run test && pnpm run lint"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.2.1-alpha.2",
    "@shikijs/langs": "^4.5.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "anser": "^2.3.5",
    "diff": "^9.0.0",
    "immer": "^10.1.1",
    "jsdom": "29.1.1",
    "katex": "^0.18.11",
    "lightningcss": "^1.33.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "oxlint": "1.81.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^4.5.0",
    "simple-icons": "16.31.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zustand": "~4.5.7"
  }
}

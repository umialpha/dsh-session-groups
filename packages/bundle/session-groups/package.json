{
  "name": "@umialpha/dsh-session-groups",
  "description": "Installable DeepSeek Harness Web profile layer for cross-project Pinned Session groups",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umialpha/dsh-session-groups.git",
    "directory": "packages/bundle/session-groups"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@umialpha/dsh-client-ui-session-groups": "workspace:*",
    "@umialpha/dsh-client-ui-workspace-groups": "workspace:*",
    "@umialpha/dsh-session-group-registry": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.2",
    "@deepseek-ai/cordis": "4.0.5-alpha.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.3.2"
  }
}
